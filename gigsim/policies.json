    "submission_fee_connects": 0,
    "featured_multiplier": 1.0,
    "submission_rules": [
      {
        "id": "P1",
        "kind": "forbid_regex",
        "pattern": "[\\w.+-]+@[\\w-]+\\.[\\w.]+",
        "message": "no email addresses (off-platform contact)"
      },
      {
        "id": "P1",
        "kind": "forbid_regex",
        "pattern": "(?<![\\w-])\\+?(?:\\d{1,3}[\\s.-]?)?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{3,4}(?![\\w-])",
        "message": "no phone numbers (off-platform contact)"
      },
      {
        "id": "P1",
        "kind": "forbid_regex",
        "pattern": "\\b(whatsapp|telegram|skype|signal app|wechat)\\b",
        "message": "no off-platform messaging apps"
      },
      {
        "id": "P4",
        "kind": "forbid_regex",
        "pattern": "\\bguarantee(d|s)?\\b",
        "message": "no guarantees of results"
      }
    ]
  },
