# Copy to .env and fill in. Never commit .env (it is git-ignored and CI scans for secrets).

# --- app
APP_ENV=development                 # production makes APP_SECRET_KEY mandatory
APP_SECRET_KEY=replace_me           # encrypts OAuth/marketplace tokens and signs MCP service tokens
COOKIE_SECURE=0                     # 1 behind HTTPS
CORS_ORIGINS=http://localhost:5173
GIGBID_PUBLIC_API_URL=http://localhost:8080
REVIEWER_EMAIL=reviewer@gigbid.dev
REVIEWER_PASSWORD=replace_me        # reviewer login, shared privately with graders
REVIEWER_PERSONA=ai_ml

# --- models (agent/config.yaml holds the per-node routing)
MODEL_PROFILE=open                  # open | open_b | local | offline | paid
GROQ_API_KEY=                       # hosted open-weight models (open, open_b profiles)
OPENAI_API_KEY=                     # only for the optional paid profile
OLLAMA_API_KEY=ollama               # local profile (docker compose ollama service)

# --- data stores (docker compose sets these for you)
DATABASE_URL=postgresql+psycopg://gigbid:gigbid@localhost:5432/gigbid
POSTGRES_PASSWORD=gigbid
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- marketplace
MARKETPLACE_MODE=gigsim             # gigsim | upwork_live
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=                   # only for stdio/local tools; users connect their own account in the UI
GIGSIM_POLICY_VERSION=2026-10       # 2026-11-02 = the change request
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=                   # optional; dynamic client registration is used when empty
UPWORK_CLIENT_SECRET=

# --- MCP servers
PORTFOLIO_MCP_URL=http://localhost:8101/mcp
MARKETPLACE_MCP_URL=http://localhost:8102/mcp
WORKSPACE_MCP_URL=http://localhost:8103/mcp
GITHUB_PERSONAL_ACCESS_TOKEN=       # read-only PAT for repo ingestion via the GitHub MCP server

# --- tracing
PHOENIX_COLLECTOR_ENDPOINT=         # e.g. http://localhost:6006 (empty = no export, trace ids still recorded)
PHOENIX_PUBLIC_URL=http://localhost:6006
