{
 "marketplace.create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalDraftInput": {
     "properties": {
      "bid_amount": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "title": "Bid Amount",
       "type": "number"
      },
      "bid_type": {
       "enum": [
        "fixed",
        "hourly"
       ],
       "title": "Bid Type",
       "type": "string"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 50,
       "title": "Cover Letter",
       "type": "string"
      },
      "job_id": {
       "pattern": "^[\\w-]{1,80}$",
       "title": "Job Id",
       "type": "string"
      },
      "screening_answers": {
       "items": {
        "type": "string"
       },
       "maxItems": 10,
       "title": "Screening Answers",
       "type": "array"
      }
     },
     "required": [
      "job_id",
      "cover_letter",
      "bid_amount",
      "bid_type"
     ],
     "title": "ProposalDraftInput",
     "type": "object"
    }
   },
   "properties": {
    "draft": {
     "$ref": "#/$defs/ProposalDraftInput"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Client-generated key; the same key always returns the first result",
     "maxLength": 120,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_.-]+$",
     "title": "Idempotency Key",
     "type": "string"
    }
   },
   "required": [
    "draft",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "properties": {
    "balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance After"
    },
    "balance_before": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance Before"
    },
    "connects_cost": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Cost"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "operation": {
     "title": "Operation",
     "type": "string"
    },
    "policy_issues": {
     "default": [],
     "items": {
      "type": "string"
     },
     "title": "Policy Issues",
     "type": "array"
    },
    "result": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Result"
    },
    "would_send": {
     "additionalProperties": true,
     "title": "Would Send",
     "type": "object"
    }
   },
   "required": [
    "operation",
    "dry_run",
    "would_send"
   ],
   "title": "WriteResult",
   "type": "object"
  }
 },
